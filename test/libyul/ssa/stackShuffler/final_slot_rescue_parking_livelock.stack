// Found by a coverage-guided run of the FeasibleTargetsAreReachableWithSpilling property
// test: v0 is demanded twice in args but only one copy sits within reach, correctly placed
// at the deepest args position. dupDeepSlotIfRequired considers that copy endangered and,
// because a correctly placed slot is never safe to swap with the top, "rescues" it via
// canSwapWithNonTopArg -- parking it at a position that demands a different value. The
// args-fixing swap then moves it right back into its correct position, five swaps per
// round-trip, until MaxIterationsReached.
initial: [v0, v1, v1, v1, v0, v5, v5, v1, v1, v1, v1, v2, v1, v1, v1, v1, v4, v4]
targetStackTop: [v0, v1, v1, v1, v1, v1, v4, v1, v1, v2, v1, v1, v1, v1, v0, JUNK, JUNK]
targetStackTailSet: {v1, v4}
targetStackSize: 19
allowSpilling: true
